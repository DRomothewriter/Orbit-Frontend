{
  "name": "orbit-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false --code-coverage",
    "test:unit:watch": "ng test",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --headless --browser chrome",
    "test:workflow": "node --test tests/deploy.workflow.test.js",
    "test:all": "npm run test:unit && npm run cypress:run",
    "lint:security": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.4.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "mediasoup-client": "^3.18.1",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@cypress/schematic": "^4.1.4",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^22.8.0",
    "autoprefixer": "^10.4.21",
    "cypress": "^15.8.2",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
